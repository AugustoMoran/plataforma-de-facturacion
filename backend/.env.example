# Backend Environment Variables
# Copy to .env and fill in your values

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB
MONGODB_URI=******localhost:27017/facturacion?authSource=admin

# Redis
REDIS_URL=redis://:redispassword@localhost:6379

# JWT
JWT_ACCESS_SECRET=changeme_access_secret_must_be_at_least_32_chars
JWT_REFRESH_SECRET=changeme_refresh_secret_must_be_at_least_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AFIP
AFIP_CUIT=20000000001
AFIP_CERT_PATH=./certs/afip.crt
AFIP_KEY_PATH=./certs/afip.key
AFIP_ENV=homologacion

# CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
