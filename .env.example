# ============================================================
# ROOT ENVIRONMENT VARIABLES
# Copy to .env and fill in your values
# ============================================================

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme_strong_password
MONGO_DB=facturacion

# Redis
REDIS_PASSWORD=changeme_redis_password

# JWT
JWT_ACCESS_SECRET=changeme_access_secret_must_be_32chars_min
JWT_REFRESH_SECRET=changeme_refresh_secret_must_be_32chars_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AFIP
AFIP_CUIT=20000000001
AFIP_CERT_PATH=/app/certs/afip.crt
AFIP_KEY_PATH=/app/certs/afip.key
AFIP_ENV=homologacion

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:80
VITE_API_URL=http://localhost:3000/api
VITE_SOCKET_URL=http://localhost:3000
